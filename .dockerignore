# Keep the build context small and avoid leaking local state into the image.
_build/
deps/
.elixir_ls/
*.ez

# Generated assets — rebuilt inside the image by Vite and `mix phx.digest`
priv/static/assets/
priv/static/frontend/
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/
priv/static/cache_manifest.json

# Dev/test/uploads
priv/static/uploads/
tmp/
.env
.env.*
!.env.example

# VCS / editor / OS
.git/
.github/
.vscode/
.DS_Store
erl_crash.dump
**/__pycache__/

# Docs and local-only ops (deployed separately, not needed in the image)
docs/
hetzner/
aws/
