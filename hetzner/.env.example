# Copy to /home/deploy/nila/.env on the server and fill in real values.
# Never commit the real .env. See hetzner/README.md "Secrets" for the full
# reference (required vs optional, defaults, effects).

# --- Database (dedicated postgres container, private `internal` network) ---
POSTGRES_USER=nila
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
POSTGRES_DB=nila_prod
# Host is the compose service name; ECTO_IPV6 unset => IPv4 over the docker bridge.
DATABASE_URL=ecto://nila:CHANGE_ME_STRONG_RANDOM@nila-postgres/nila_prod
POOL_SIZE=10

# --- Phoenix ---
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=CHANGE_ME_64_BYTES
# PHX_HOST and PORT are set by docker-compose.yml (environment:), not here.

# --- Assistant (OpenAI-compatible LLM) ---
# Required in prod; boot raises without it.
ASSISTANT_API_KEY=CHANGE_ME
# Optional. Defaults: base_url https://api.stepfun.ai/v1, model step-3.7-flash.
# Uncomment to switch provider, e.g. NVIDIA:
# ASSISTANT_BASE_URL=https://integrate.api.nvidia.com/v1
# ASSISTANT_MODEL=...
# ASSISTANT_RECEIVE_TIMEOUT=60000
# ASSISTANT_EXTRA_HEADERS={"x-portkey-api-key":"...","x-portkey-provider":"openai"}

# --- Cloudflare R2 private object storage ---
R2_ENDPOINT=https://0b6491b35807b48232b57646af4e7eeb.r2.cloudflarestorage.com
R2_BUCKET=nila-documents
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME

# --- Resend transactional email (needed for invites to deliver) ---
# Without it the mailer is inert in prod and invite emails are silently dropped.
# MAIL_FROM's domain must be verified in Resend. nila.tax is verified, so send
# from it; onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=CHANGE_ME
MAIL_FROM=noreply@nila.tax
# MAIL_FROM_NAME=Nila

# --- GST OCR (required in production) ---
# Mistral OCR is the operational provider. Selection remains explicit and there
# is no automatic fallback. Llama credentials are only needed for paid benchmarks.
GST_OCR_PROVIDER=mistral
MISTRAL_API_KEY=CHANGE_ME
# MISTRAL_BASE_URL=https://api.mistral.ai
# LLAMA_CLOUD_API_KEY=...
# LLAMA_PROJECT_ID=...
# LLAMA_VERSION=...

# --- Integration credential encryption (optional) ---
# Encrypts stored integration creds. Falls back to SECRET_KEY_BASE if unset; set
# it explicitly so rotating SECRET_KEY_BASE doesn't lock you out of saved creds.
# INTEGRATION_CREDENTIAL_KEY=CHANGE_ME

# --- Gmail integration (optional; inactive when unset) ---
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GMAIL_REDIRECT_URI=https://nila.tax/integrations/gmail/callback

# --- WhatsApp integration (webhook values required in production) ---
# WHATSAPP_APP_ID=...
# WHATSAPP_APP_SECRET=...
# WHATSAPP_VERIFY_TOKEN=...
# Embedded Signup remains hidden unless the app ID/secret, config ID, and allowed
# business ID are all set. During testing, allow only an app-role user's business.
# WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=...
# WHATSAPP_EMBEDDED_SIGNUP_ALLOWED_BUSINESS_ID=...
# WHATSAPP_CHASE_TEMPLATE=nila_document_chase
# WHATSAPP_COMPLETENESS_TEMPLATE=nila_sales_completeness
# At least 32 bytes; signs period-specific Yes/No quick replies.
# WHATSAPP_COMPLETENESS_SECRET=...
# Optional override when Meta's Graph API version changes.
# WHATSAPP_GRAPH_URL=https://graph.facebook.com/v26.0
