{
  "name": "nila-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check && vite build",
    "check": "pnpm run api:check && tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "test": "playwright test",
    "api:generate": "openapi-typescript ../priv/openapi/sales-workspace.json -o src/lib/generated/sales-workspace.ts",
    "api:check": "openapi-typescript ../priv/openapi/sales-workspace.json -o src/lib/generated/sales-workspace.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
