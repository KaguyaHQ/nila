<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{if assigns[:page_title], do: "#{assigns[:page_title]} · Nila", else: "Nila"}</title>

    <meta
      name="description"
      content="Nila is the AI accountant for India's CA firms — dump an unstructured mess and get drafted GST returns, invoices, and registers, with humans reviewing only the exceptions."
    /> <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nila" />
    <meta property="og:title" content="Nila — AI for India's CA firms" />
    <meta
      property="og:description"
      content="The AI accountant for India's CA firms. Dump the mess; Nila drafts the GST returns, invoices, and registers. You review only the exceptions."
    /> <meta property="og:image" content={url(~p"/images/og-image.png")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Nila — AI for India's CA firms" />
    <meta
      name="twitter:description"
      content="The AI accountant for India's CA firms. Dump the mess; Nila drafts the GST returns, invoices, and registers. You review only the exceptions."
    /> <meta name="twitter:image" content={url(~p"/images/og-image.png")} />
    <%!-- Stable, un-digested paths on purpose: favicons want a constant URL, and
          Plug.Static's `only` list allows these exact names but not the
          content-hashed variants `~p` would produce. Modern browsers pick the
          SVG and fall back to the .ico themselves — no "alternate" rel needed. --%>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>

  <body>
    {@inner_content}
  </body>
</html>
