<.page_shell flash={@flash}>
  <main class="mx-auto max-w-5xl px-6 pt-16 pb-28 sm:pt-24 sm:pb-36">
    <section class="max-w-3xl">
      <p class="text-eyebrow text-ink-subtle font-semibold uppercase">Put Nila to the test</p>
      <h1 class="font-display text-statement mt-6 font-normal text-balance">
        Try Nila on one client.
      </h1>
      <p class="text-ink-muted text-lead mt-6 max-w-2xl font-light">
        Start with one client’s sales bills. We’ll return a Tally sales register
        you can compare entry by entry. No client documents change hands until
        we’ve agreed on a secure handoff.
      </p>
    </section>

    <div class="mt-16 grid gap-6 lg:grid-cols-2">
      <section class="moonlight-night rounded-box text-inverse flex flex-col p-8 sm:p-10">
        <p class="text-eyebrow text-inverse/55 font-semibold uppercase">Fastest</p>
        <h2 class="font-display text-h3 mt-5 font-normal">Continue on WhatsApp.</h2>
        <p class="text-body text-inverse/65 mt-4 max-w-md font-light">
          The message is already written. Send it and we’ll arrange a secure
          handoff for the bills.
        </p>
        <div class="mt-10">
          <.link
            href={whatsapp_url()}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-panel-surface rounded-field text-ink text-ui inline-flex h-12 items-center gap-2 px-7 font-semibold transition hover:opacity-90"
          >
            <.icon name="nila-whatsapp" class="size-4 shrink-0" /> Try one client free
          </.link>
        </div>
        <p class="text-body text-inverse/45 mt-auto pt-8">
          We won’t ask for confidential client files in the first message.
        </p>
      </section>

      <section class="landing-tile rounded-box p-8 sm:p-10">
        <p class="text-eyebrow text-ink-subtle font-semibold uppercase">Prefer a call?</p>
        <h2 class="font-display text-h3 mt-5 font-normal">We’ll call you.</h2>
        <p class="text-ink-muted text-ui mt-3">
          Leave the minimum. No mailing list, no sales sequence.
        </p>

        <.form
          for={@form}
          id="callback-form"
          action={~p"/contact/callback"}
          method="post"
          class="mt-8 space-y-5"
        >
          <.input field={@form[:name]} label="Your name" autocomplete="name" required />
          <.input field={@form[:firm]} label="Firm" autocomplete="organization" required />
          <.input
            field={@form[:phone]}
            type="tel"
            label="Phone"
            autocomplete="tel"
            inputmode="tel"
            required
          />
          <div class="hidden" aria-hidden="true">
            <.input
              field={@form[:website]}
              label="Website"
              autocomplete="off"
              tabindex="-1"
            />
          </div>
          <.button type="submit" variant="neutral" size="lg" class="w-full">
            Request a callback
          </.button>
        </.form>
      </section>
    </div>

    <section class="border-rule/60 text-ink-subtle text-ui mt-16 border-t pt-8">
      <p>
        Prefer email?
        <a
          href="mailto:hello@nila.tax?subject=Put%20Nila%20to%20the%20test"
          class="text-ink font-medium hover:underline"
        >
          hello@nila.tax
        </a>
      </p>
      <p class="text-ui mt-3">
        Privacy and data requests:
        <a href="mailto:privacy@nila.tax?subject=Data%20request" class="hover:text-ink transition">
          privacy@nila.tax
        </a>
      </p>
    </section>
  </main>
</.page_shell>
