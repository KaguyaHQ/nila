<Layouts.flash_group flash={@flash} />

<.page_shell>
  <section class="relative pt-16 pb-14 pl-10 sm:pl-12 lg:pt-20 lg:pl-48">
    <p class="text-ink/55 text-label mb-6 font-semibold uppercase lg:absolute lg:top-20 lg:left-0 lg:mb-0 lg:w-32 lg:text-right">
      Contact
    </p>

    <h1 class="font-display text-hero max-w-3xl font-normal">Talk to us.</h1>

    <p class="text-ink/75 text-lead mt-7 max-w-xl font-light">
      Nila is built and run by a small team in Chennai. Mail reaches a person,
      not a queue — whether you want to put us to the test, ask about your data,
      or raise a problem with the service.
    </p>

    <dl class="border-feint mt-12 grid max-w-2xl gap-8 border-t pt-8 sm:grid-cols-2">
      <div>
        <dt class="text-ink/55 text-label font-semibold uppercase">General &amp; sales</dt>
        <dd class="mt-2">
          <a
            href="mailto:hello@nila.tax?subject=Hello%20Nila"
            class="hover:text-redink text-body font-medium transition"
          >
            hello@nila.tax
          </a>
        </dd>
      </div>
      <div>
        <dt class="text-ink/55 text-label font-semibold uppercase">
          Privacy &amp; data requests
        </dt>
        <dd class="mt-2">
          <a
            href="mailto:privacy@nila.tax?subject=Data%20request"
            class="hover:text-redink text-body font-medium transition"
          >
            privacy@nila.tax
          </a>
        </dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-ink/55 text-label font-semibold uppercase">Registered office</dt>
        <dd class="text-body text-ink/75 mt-2 font-light">
          Kaguya Media Private Limited<br /> Chennai, Tamil Nadu, India<br />
          <span class="text-fine text-ink/55">GSTIN 33AALCK1118R1Z8</span>
        </dd>
      </div>
    </dl>
  </section>
</.page_shell>
