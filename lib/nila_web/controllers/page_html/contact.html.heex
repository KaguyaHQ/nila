<Layouts.flash_group flash={@flash} />

<div class="landing text-ink min-h-screen">
  <header>
    <div class="mx-auto flex h-20 max-w-5xl items-center justify-between px-6">
      <.link navigate={~p"/"} class="inline-flex items-center">
        <.logo class="text-ink h-6 w-auto" />
      </.link>
      <.link
        navigate={~p"/users/log_in"}
        class="hover:text-ink text-ink-subtle text-small font-medium transition"
      >
        Log in
      </.link>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-6 pt-16 pb-28 sm:pt-24 sm:pb-36">
    <section class="max-w-3xl">
      <p class="text-eyebrow text-ink-subtle font-semibold uppercase">Put Nila to the test</p>
      <h1 class="font-display text-statement mt-6 font-normal text-balance">
        Give us one filed month.
      </h1>
      <p class="text-ink-muted text-lead mt-6 max-w-2xl font-light">
        We’ll reproduce the workings so you can compare the output line by line.
        No client documents change hands until we’ve agreed on a secure handoff.
      </p>
    </section>

    <div class="mt-16 grid gap-6 lg:grid-cols-2">
      <section class="moonlight-night rounded-box text-base-100 flex flex-col p-8 sm:p-10">
        <p class="text-base-100/55 text-eyebrow font-semibold uppercase">Fastest</p>
        <h2 class="font-display text-h3 mt-5 font-normal">Continue on WhatsApp.</h2>
        <p class="text-base-100/65 text-body mt-4 max-w-md font-light">
          The message is already written. Send it and a person from Nila will
          arrange the test with you.
        </p>
        <div class="mt-10">
          <.link
            href={whatsapp_url()}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-base-100 rounded-field text-ink text-small inline-flex h-12 items-center px-7 font-semibold transition hover:opacity-90"
          >
            Arrange on WhatsApp
          </.link>
        </div>
        <p class="text-base-100/45 text-fine mt-auto pt-8">
          We won’t ask for confidential client files in the first message.
        </p>
      </section>

      <section class="landing-tile rounded-box p-8 sm:p-10">
        <p class="text-eyebrow text-ink-subtle font-semibold uppercase">Prefer a call?</p>
        <h2 class="font-display text-h3 mt-5 font-normal">We’ll call you.</h2>
        <p class="text-ink-muted text-small mt-3">
          Leave the minimum. No mailing list, no sales sequence.
        </p>

        <.form
          for={@form}
          id="callback-form"
          action={~p"/contact/callback"}
          method="post"
          class="mt-8 space-y-5"
        >
          <.input field={@form[:name]} label="Your name" autocomplete="name" required />
          <.input field={@form[:firm]} label="Firm" autocomplete="organization" required />
          <.input
            field={@form[:phone]}
            type="tel"
            label="Phone"
            autocomplete="tel"
            inputmode="tel"
            required
          />
          <div class="hidden" aria-hidden="true">
            <.input
              field={@form[:website]}
              label="Website"
              autocomplete="off"
              tabindex="-1"
            />
          </div>
          <.button type="submit" variant="neutral" size="lg" class="w-full">
            Request a callback
          </.button>
        </.form>
      </section>
    </div>

    <section class="border-base-300/60 text-ink-subtle text-small mt-16 border-t pt-8">
      <p>
        Prefer email?
        <a
          href="mailto:hello@nila.tax?subject=Put%20Nila%20to%20the%20test"
          class="text-ink font-medium hover:underline"
        >
          hello@nila.tax
        </a>
      </p>
      <p class="text-fine mt-3">
        Privacy and data requests:
        <a href="mailto:privacy@nila.tax?subject=Data%20request" class="hover:text-ink transition">
          privacy@nila.tax
        </a>
      </p>
    </section>
  </main>

  <footer class="mx-auto max-w-5xl px-6 pb-10">
    <div class="border-base-300/60 flex flex-col items-center gap-4 border-t pt-8 sm:flex-row sm:justify-between">
      <.link navigate={~p"/"} class="inline-flex items-center">
        <.logo class="text-ink-subtle h-5 w-auto" />
      </.link>
      <nav class="text-fine text-ink-subtle flex items-center gap-6">
        <.link navigate={~p"/privacy"} class="hover:text-ink transition">Privacy</.link>
        <.link navigate={~p"/terms"} class="hover:text-ink transition">Terms</.link>
      </nav>
      <p class="text-ink-subtle text-micro">© 2026 Nila · Kaguya Media Private Limited</p>
    </div>
  </footer>
</div>
