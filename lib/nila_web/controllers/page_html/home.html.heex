<Layouts.flash_group flash={@flash} />

<%!-- Moonlight homepage. Judged against docs/design/TASTE.md:
     delicate type in large space, near-zero borders, one authored moment of
     light, the artifact bigger than the pitch, pulled along by intent. --%>
<div class="landing text-ink min-h-screen">
  <%!-- ── The night ─────────────────────────────────────────────────────── --%>
  <section class="landing-night relative overflow-hidden">
    <.public_header inverted class="absolute inset-x-0 top-0 z-20" />

    <div class="relative z-10 mx-auto max-w-4xl px-6 pt-32 text-center sm:pt-36">
      <div
        class="moon-rise mx-auto flex h-28 items-center justify-center sm:h-32"
        aria-hidden="true"
      >
        <div class="landing-moon"></div>
      </div>

      <h1 class="font-display moon-rise text-h2 text-inverse mt-8 font-normal [animation-delay:220ms]">
        <span class="block">GST deadlines</span>
        <span class="text-inverse/70 block">without the late nights.</span>
      </h1>

      <p class="moon-rise text-inverse/60 text-lead mx-auto mt-7 max-w-3xl font-light [animation-delay:320ms]">
        Nila chases the bills, enters them, and reconciles GSTR-2B
        so your juniors don’t have to.
      </p>

      <div class="moon-rise mt-9 [animation-delay:440ms]">
        <.link
          href={whatsapp_url()}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-panel-surface rounded-field text-ink text-ui inline-flex h-12 items-center gap-2 px-7 font-semibold transition hover:opacity-90"
        >
          <.icon name="nila-whatsapp" class="size-4 shrink-0" /> Try one client free
        </.link>
        <p class="text-ui mt-4">
          <.link
            navigate={~p"/contact"}
            class="decoration-inverse/30 hover:decoration-inverse/60 hover:text-inverse text-inverse/60 underline underline-offset-4 transition"
          >
            Prefer email or a callback?
          </.link>
        </p>
      </div>
    </div>

    <%!-- Air for the dawn horizon; the artifact below overlaps into it. --%>
    <div class="h-72 sm:h-80" aria-hidden="true"></div>
  </section>

  <%!-- ── The artifact: a finished month in first light ─────────────────── --%>
  <div class="relative z-10 mx-auto -mt-56 max-w-2xl px-6 sm:-mt-60">
    <div class="bg-panel-surface landing-lift moon-rise rounded-box p-8 [animation-delay:420ms] sm:p-10">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <p class="text-ui font-semibold">
          Sundaram Textiles LLP <span class="text-ink-subtle font-normal">· June 2026</span>
        </p>
        <p class="text-ink-subtle text-ui inline-flex items-center gap-2 tabular-nums">
          <span class="bg-accent size-2 rounded-full" aria-hidden="true"></span>
          Ready for review · 6:04 AM
        </p>
      </div>

      <div class="mt-10">
        <p class="text-ink-subtle text-label font-semibold uppercase">
          Input credit reconciled
        </p>
        <p class="font-display text-h2 mt-3 leading-none font-normal tabular-nums">
          ₹12,40,318
        </p>
        <p class="text-ink-subtle text-ui mt-3 tabular-nums">
          247 of 252 purchase lines matched to GSTR-2B
        </p>
      </div>

      <div class="mt-10">
        <p class="text-ink-subtle text-label font-semibold uppercase">
          Needs you · 5
        </p>
        <ul class="mt-4">
          <li
            :for={
              {{vendor, issue, amount}, index} <-
                Enum.with_index([
                  {"Apex Polymers", "In your register, missing from the 2B", "₹1,12,500"},
                  {"Sri Venkateswara Steels", "Supplier GSTIN inactive since May", "₹84,000"},
                  {"Chennai Freight Co", "Register ₹18,400 · 2B ₹14,800", "₹18,400"},
                  {"Meenakshi Traders", "Invoice 447 appears twice", "₹42,750"},
                  {"Kaveri Packaging", "New supplier, first invoice", "₹28,900"}
                ])
            }
            class={[
              "moon-rise flex items-baseline justify-between gap-6 py-3",
              index > 0 && "border-rule/60 border-t"
            ]}
            style={"animation-delay: #{560 + index * 90}ms"}
          >
            <p class="text-ui min-w-0">
              <span class="font-medium">{vendor}</span>
              <span class="text-ink-subtle block font-light sm:mt-0.5">{issue}</span>
            </p>
            <p class="font-display text-ui shrink-0 leading-none tabular-nums">{amount}</p>
          </li>
        </ul>
      </div>

      <p class="text-body text-ink-subtle mt-8">
        Everything else is entered, matched, and carried to the register.
      </p>
    </div>
  </div>

  <%!-- ── What reaches Nila ─────────────────────────────────────────────── --%>
  <section class="mx-auto max-w-3xl px-6 pt-32 pb-0 text-center sm:pt-40">
    <p class="text-eyebrow text-ink-subtle font-semibold uppercase">What reaches Nila</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <div class="landing-tile rounded-box p-5">
        <p class="text-ink-subtle text-label font-semibold uppercase">From your clients</p>
        <p class="text-ink-muted text-ui mt-2">Bills, as WhatsApp photos</p>
      </div>
      <div class="landing-tile rounded-box p-5">
        <p class="text-ink-subtle text-label font-semibold uppercase">From Tally</p>
        <p class="text-ink-muted text-ui mt-2">The purchase register</p>
      </div>
      <div class="landing-tile rounded-box p-5">
        <p class="text-ink-subtle text-label font-semibold uppercase">From the portal</p>
        <p class="text-ink-muted text-ui mt-2">GSTR-2B</p>
      </div>
    </div>
    <p class="text-ink-faint mt-5" aria-hidden="true">↓</p>
    <p class="mt-5">
      <span class="bg-inverse-surface rounded-field text-inverse text-ui inline-flex px-4 py-2 font-medium">
        One finished month
      </span>
    </p>
    <p class="font-display text-ink-muted text-lead mx-auto mt-10 max-w-md font-light italic">
      Your clients change nothing. The chasing is Nila’s job — done in your
      firm’s name.
    </p>
  </section>

  <%!-- ── A month with Nila ─────────────────────────────────────────────── --%>
  <section class="mx-auto max-w-4xl px-6 pt-32 text-center sm:pt-40">
    <p class="text-eyebrow text-ink-subtle font-semibold uppercase">A month with Nila</p>
    <div class="relative mt-12">
      <div
        class="border-rule/70 absolute top-1 right-[12.5%] left-[12.5%] hidden border-t sm:block"
        aria-hidden="true"
      >
      </div>
      <div class="grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-4">
        <div
          :for={
            {day, event, last} <- [
              {"All month", "Bills arrive on WhatsApp; Nila chases the stragglers", false},
              {"The 14th", "The 2B lands — every line reconciled within the hour", false},
              {"The 15th", "The month is on your desk; five calls need a CA", false},
              {"The 20th", "You sign, it files", true}
            ]
          }
          class="relative flex flex-col items-center gap-4"
        >
          <span
            class={["size-2 rounded-full", (last && "bg-accent") || "bg-rule"]}
            aria-hidden="true"
          ></span>
          <p class="font-display text-h4 leading-none font-normal">{day}</p>
          <p class="text-ink-subtle text-ui max-w-44">{event}</p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── The decision ──────────────────────────────────────────────────── --%>
  <section class="mx-auto max-w-2xl px-6 pt-32 sm:pt-40">
    <div class="text-center">
      <h2 class="font-display text-h3 font-normal">
        A guess never looks like a fact.
      </h2>
    </div>

    <div class="landing-tile rounded-box mt-12 p-8">
      <p class="text-ui font-semibold">
        Chennai Freight Co <span class="text-ink-subtle font-normal">· Invoice CF-2214</span>
      </p>

      <div class="mt-6 grid grid-cols-2 gap-4">
        <div class="bg-panel-surface rounded-field px-5 py-4">
          <p class="text-ink-subtle text-label font-semibold uppercase">Your register</p>
          <p class="font-display text-h4 mt-2 leading-none tabular-nums">₹18,400</p>
        </div>
        <div class="bg-panel-surface rounded-field px-5 py-4">
          <p class="text-ink-subtle text-label font-semibold uppercase">GSTR-2B</p>
          <p class="font-display text-h4 mt-2 leading-none tabular-nums">₹14,800</p>
        </div>
      </div>

      <p class="font-display text-body text-ink-muted mt-6 font-light italic">
        The 2B entry carries May’s freight rate — likely the revised invoice.
        Confirm which figure to claim.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <span class="bg-inverse-surface rounded-field text-inverse text-ui inline-flex h-9 items-center px-4 font-medium">
          Claim ₹14,800
        </span>
        <span class="ring-rule rounded-field text-ink-muted text-ui inline-flex h-9 items-center px-4 font-medium ring-1">
          Keep ₹18,400
        </span>
      </div>
    </div>

    <p class="text-body text-ink-subtle mt-6 text-center">
      Nothing reaches a return without your tap.
    </p>
  </section>

  <%!-- ── The close ─────────────────────────────────────────────────────── --%>
  <section class="mx-auto max-w-4xl px-6 pt-36 pb-32 text-center sm:pt-44">
    <h2 class="font-display text-statement font-normal text-balance">
      Turn sales bills into a Tally register in minutes.
    </h2>
    <p class="text-ink-muted text-lead mt-6 font-light">
      Try one client free. Send the bills and get the completed register back.
    </p>
    <div class="mt-10">
      <.link
        href={whatsapp_url()}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-inverse-surface rounded-field text-inverse text-ui inline-flex h-12 items-center gap-2 px-7 font-semibold transition hover:opacity-85"
      >
        <.icon name="nila-whatsapp" class="size-4 shrink-0" /> Try one client free
      </.link>
    </div>
    <p class="text-ink-subtle text-ui mt-6">
      <.link navigate={~p"/contact"} class="hover:text-ink transition">
        Prefer email or a callback?
      </.link>
    </p>
  </section>

  <.page_footer />
</div>
