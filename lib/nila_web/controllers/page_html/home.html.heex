<Layouts.flash_group flash={@flash} />

<div class="bg-base-100 text-base-content">
  <%!-- ── HEADER ─────────────────────────────────────────────────────────── --%>
  <header class="fixed inset-x-0 top-3 z-40 px-4 sm:top-4 sm:px-6">
    <div class="bg-base-100/85 border-base-300/60 shadow-moon-lg mx-auto flex w-fit items-center gap-6 rounded-full border py-2 pr-2 pl-5 backdrop-blur">
      <a href="/" class="flex items-center">
        <.logo class="text-base-content h-7 w-auto" />
      </a>
      <div class="flex items-center gap-1.5">
        <.link
          navigate={~p"/users/log_in"}
          class="hover:text-base-content text-base-content/70 text-small hidden h-9 items-center px-3 font-medium transition sm:inline-flex"
        >
          Log in
        </.link>
        <.link
          href="mailto:hello@nilahq.com"
          class="bg-base-content shadow-moon text-base-100 text-small inline-flex h-9 items-center gap-1.5 rounded-full px-4 font-medium transition hover:opacity-90"
        >
          Talk to us <.icon name="hero-arrow-right" class="size-3.5" />
        </.link>
      </div>
    </div>
  </header>

  <%!-- ── HERO ───────────────────────────────────────────────────────────── --%>
  <section class="moonlight-night text-base-100 relative overflow-hidden">
    <div class="mx-auto flex max-w-3xl flex-col items-center px-4 pt-40 pb-28 text-center sm:px-6 sm:pt-48 sm:pb-36 lg:pt-56 lg:pb-44">
      <div class="bg-base-100/5 border-base-100/15 moon-rise text-base-100/70 text-eyebrow inline-flex items-center gap-2 rounded-full border px-3 py-1 font-semibold uppercase backdrop-blur">
        <span
          class="bg-accent shadow-accent/60 size-1.5 rounded-full shadow-[0_0_10px_2px]"
          aria-hidden="true"
        ></span>
        For India's CA firms
      </div>

      <h1 class="font-display moon-rise text-base-100 text-hero mt-8 font-normal [animation-delay:80ms]">
        Serve more clients.
        <span class="text-accent whitespace-nowrap italic">Without adding staff.</span>
      </h1>

      <p class="moon-rise text-base-100/65 text-lead mt-8 max-w-xl font-light [animation-delay:160ms]">
        Nila does the groundwork your juniors do by hand. Bank statements
        classified, GSTR-2B reconciled, GST returns drafted, synced to Tally.
        Your team reviews and signs.
      </p>

      <div class="moon-rise mt-10 [animation-delay:240ms]">
        <.link
          href="mailto:hello@nilahq.com"
          class="bg-base-100 group hover:shadow-base-100/55 shadow-base-100/40 text-base-content text-small inline-flex h-11 items-center gap-2 rounded-md px-6 font-medium shadow-[0_0_30px_-4px] transition hover:shadow-[0_0_44px_-2px]"
        >
          Talk to us
          <.icon
            name="hero-arrow-right"
            class="size-4 transition group-hover:translate-x-0.5"
          />
        </.link>
      </div>

      <%!-- Living proof, recessed into the night: a finished overnight run, the
           work already done, not a product screenshot. One quiet line, low
           contrast: a glance at what it produces, not a UI being presented. --%>
      <div class="moon-rise mt-20 w-full max-w-xl [animation-delay:340ms]">
        <p class="text-base-100/35 text-label font-medium uppercase">
          Ready when you open it
        </p>
        <dl class="border-base-100/10 divide-base-100/10 mt-5 divide-y border-y">
          <div class="flex items-baseline gap-4 py-3.5 text-left">
            <dt class="text-base-100/65 text-small flex min-w-0 flex-1 items-center gap-2.5">
              <span class="bg-accent size-1.5 shrink-0 rounded-full" aria-hidden="true"></span>
              <span class="truncate">HDFC statement classified, 7 flagged for your review</span>
            </dt>
            <dd class="font-display text-base-100/80 text-body tabular-nums">412 entries</dd>
          </div>
          <div class="flex items-baseline gap-4 py-3.5 text-left">
            <dt class="text-base-100/65 text-small flex min-w-0 flex-1 items-center gap-2.5">
              <span class="bg-base-100/30 size-1.5 shrink-0 rounded-full" aria-hidden="true"></span>
              <span class="truncate">GSTR-2B reconciled against the books</span>
            </dt>
            <dd class="font-display text-base-100/80 text-body tabular-nums">3 mismatches</dd>
          </div>
          <div class="flex items-baseline gap-4 py-3.5 text-left">
            <dt class="text-base-100/45 text-small flex min-w-0 flex-1 items-center gap-2.5">
              <span class="bg-success/70 size-1.5 shrink-0 rounded-full" aria-hidden="true"></span>
              <span class="decoration-base-100/20 truncate line-through">
                October GSTR-3B drafted, ready to file
              </span>
            </dt>
            <dd class="font-display text-base-100/45 text-body tabular-nums">₹2,14,800</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <%!-- ── DOES THE WORK: the differentiator vs every tracker on the market ── --%>
  <section id="work" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
    <div class="max-w-2xl">
      <h2 class="font-display text-h2 font-normal">
        It doesn't track the work.
        <span class="text-base-content/50 italic">It does the work.</span>
      </h2>
      <p class="text-base-content/65 text-lead mt-5 font-light">
        Every other tool hands you a dashboard and leaves the typing to your
        juniors. Nila reads what arrives, classifies it, reconciles it against
        GSTR-2B, and hands back a finished draft. A person steps in only to
        review and sign.
      </p>
    </div>

    <div class="mt-14 grid items-stretch gap-4 lg:grid-cols-[1fr_auto_1fr] lg:gap-0">
      <%!-- raw input, muted --%>
      <div class="bg-base-200/40 border-base-300/70 rounded-box border p-5 sm:p-6">
        <p class="text-base-content/45 text-label font-semibold uppercase">
          What arrives
        </p>
        <ul class="divide-base-300/50 mt-3 divide-y">
          <%= for {icon, name, meta} <- [
            {"hero-document-text", "hdfc_statement.pdf", "Bank · 412 transactions"},
            {"hero-camera", "purchase bills", "WhatsApp · 14 photos"},
            {"hero-arrow-down-tray", "GSTR-2B · October", "GST portal · downloaded"}
          ] do %>
            <li class="flex items-center gap-3 py-3 first:pt-2">
              <.icon name={icon} class="text-base-content/40 size-4 shrink-0" />
              <div class="min-w-0">
                <p class="text-small truncate font-medium">{name}</p>
                <p class="text-base-content/50 text-micro truncate">{meta}</p>
              </div>
            </li>
          <% end %>
        </ul>
      </div>

      <%!-- the engine, between the two --%>
      <div class="flex flex-col items-center justify-center gap-2 lg:px-7">
        <span class="bg-base-content shadow-moon text-base-100 grid size-10 place-items-center rounded-full">
          <.icon name="hero-sparkles" class="size-4" />
        </span>
        <.icon name="hero-arrow-down" class="text-base-content/40 size-4 lg:hidden" />
        <.icon name="hero-arrow-right" class="text-base-content/40 hidden size-4 lg:block" />
      </div>

      <%!-- finished draft, elevated: the payoff --%>
      <div class="bg-base-100 border-base-300 rounded-box shadow-moon-lg border p-5 sm:p-6">
        <p class="text-label text-moon font-semibold uppercase">
          What Nila produces
        </p>
        <div class="mt-4">
          <p class="text-small font-semibold tracking-tight tabular-nums">
            GSTR-3B · October 2026
          </p>
          <p class="text-base-content/50 text-micro mt-0.5">
            Anand Traders · monthly GST
          </p>
          <p class="font-display text-h3 mt-3 leading-none font-normal tabular-nums">
            ₹2,14,800<span class="text-base-content/40">.00</span>
          </p>
          <p class="text-base-content/50 text-micro mt-1">Net tax payable</p>
        </div>
        <dl class="border-base-300/40 mt-5 space-y-2.5 border-t pt-4">
          <%= for {label, value} <- [
            {"Input tax credit", "₹1,86,400"},
            {"Ledger", "Tally, synced"},
            {"Flagged", "7 for review"}
          ] do %>
            <div class="text-fine flex items-center justify-between gap-3">
              <dt class="text-base-content/50">{label}</dt>
              <dd class="font-medium tabular-nums">{value}</dd>
            </div>
          <% end %>
        </dl>
        <p class="text-micro text-success mt-4 flex items-center gap-1.5 font-medium">
          <.icon name="hero-check-circle" class="size-3.5" /> Reconciled against GSTR-2B
        </p>
      </div>
    </div>
  </section>

  <%!-- ── LEARNS: the moat, night band, the thing a tracker can't copy ────── --%>
  <section class="border-base-100/5 moonlight-night text-base-100 relative overflow-hidden border-y">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="text-base-100/40 text-eyebrow font-semibold uppercase">
            Why it isn't just another tracker
          </p>
          <h2 class="font-display text-base-100 text-h2 mt-4 font-normal">
            Every month, it knows your clients <span class="text-accent italic">better.</span>
          </h2>
          <p class="text-base-100/65 text-lead mt-6 font-light">
            Trackers don't learn. A working engine does. Every statement, bill,
            and return teaches Nila how each client's books actually move, until
            the groundwork is finished before anyone opens it.
          </p>
        </div>

        <div class="lg:col-span-7">
          <dl class="bg-base-100/10 border-base-100/10 rounded-box grid gap-px overflow-hidden border sm:grid-cols-2">
            <%= for {month, label, body} <- [
              {"Month 1", "Learns the recurring entries", "Rent, salaries, regular vendors. It maps each client's repeat transactions to the right ledger head, the way your senior would."},
              {"Month 2", "Learns the exceptions", "The odd entries your juniors used to puzzle over get recognised and handled, not bounced back to a person."},
              {"Month 3", "Reconciliation sharpens", "Fewer GSTR-2B mismatches reach your desk. The ones that do are the ones that genuinely need judgement."},
              {"Month 6", "Review, don't produce", "Classification, reconciliation, and drafting are done before your team logs in. They review and sign."}
            ] do %>
              <div class="bg-[oklch(24%_0.05_245)] p-6">
                <p class="text-accent/80 text-label font-semibold uppercase">
                  {month}
                </p>
                <p class="font-display text-base-100 text-h4 mt-2">{label}</p>
                <p class="text-base-100/60 text-small mt-2 font-light">
                  {body}
                </p>
              </div>
            <% end %>
          </dl>
          <p class="text-base-100/40 text-fine mt-5">
            That accumulated context is the moat. It can't be cloned by bolting
            AI onto a form people fill in by hand.
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── COLLECTS: the chase clients never stop needing ─────────────────── --%>
  <section id="collects" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 class="font-display text-h2 font-normal">
          You stop chasing clients. <span class="text-base-content/50 italic">Nila does it.</span>
        </h2>
        <p class="text-base-content/65 text-lead mt-6 font-light">
          The two things that never stop: getting documents out of clients, and
          getting paid. Nila runs the follow-up over WhatsApp and email,
          composing, sending, reading the replies, and pulls you in only when a
          person is actually needed.
        </p>
        <p class="text-base-content/55 text-fine mt-7">
          The same chase, every month, off your plate.
        </p>
      </div>

      <div class="lg:col-span-7">
        <div class="bg-base-100 border-base-300 rounded-box shadow-moon-lg overflow-hidden border">
          <div class="border-base-300/60 flex items-center justify-between border-b px-5 py-4 sm:px-6">
            <div class="min-w-0">
              <p class="text-small truncate font-semibold tracking-tight">
                Anand Traders · Q2 retainer
              </p>
              <p class="text-base-content/55 text-fine mt-0.5 tabular-nums">
                Reminder over WhatsApp and email
              </p>
            </div>
            <p class="text-small font-semibold tabular-nums">₹20,000.00</p>
          </div>

          <div class="flex items-center gap-4 px-5 py-7 sm:px-6">
            <span class="bg-success/15 text-success grid size-11 shrink-0 place-items-center rounded-full">
              <.icon name="hero-check" class="size-6" />
            </span>
            <div class="min-w-0">
              <p class="text-h4 font-semibold tracking-tight">Paid</p>
              <p class="text-base-content/55 text-fine mt-0.5">
                after 2 reminders, none from you
              </p>
            </div>
          </div>

          <div class="bg-base-200/30 border-base-300/60 text-base-content/55 text-fine flex items-center gap-2 border-t px-5 py-3 sm:px-6">
            <span class="flex items-center gap-1.5">
              Sent <span class="text-base-content/30">→</span>
              Reminder ×2 <span class="text-base-content/30">→</span>
              <span class="text-base-content/75 font-medium">Paid</span>
            </span>
            <span class="text-base-content/70 ml-auto font-medium tabular-nums">
              0 nudges from you
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── CLOSING CTA: close in night, bookend the hero ──────────────────── --%>
  <section class="border-base-100/5 moonlight-night text-base-100 relative overflow-hidden border-t">
    <div class="mx-auto max-w-3xl px-4 py-28 text-center sm:px-6 sm:py-36">
      <h2 class="font-display text-base-100 text-statement font-normal">
        Hand it the groundwork. <span class="text-accent block italic">Review and sign.</span>
      </h2>
      <p class="text-base-100/60 text-lead mx-auto mt-7 max-w-lg font-light">
        Built for staffed CA firms running monthly GST, TDS, and bookkeeping
        across India.
      </p>
      <div class="mt-10 flex justify-center">
        <.link
          href="mailto:hello@nilahq.com"
          class="bg-base-100 group hover:shadow-base-100/55 shadow-base-100/40 text-base-content text-body inline-flex h-12 items-center gap-2 rounded-md px-6 font-medium shadow-[0_0_34px_-4px] transition hover:shadow-[0_0_48px_-2px]"
        >
          Talk to us
          <.icon
            name="hero-arrow-right"
            class="size-4 transition group-hover:translate-x-0.5"
          />
        </.link>
      </div>
    </div>
  </section>

  <%!-- ── FOOTER ─────────────────────────────────────────────────────────── --%>
  <footer class="bg-base-200/35 border-base-300/60 border-t">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-14">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <a href="/" class="inline-flex items-center">
            <.logo class="text-base-content h-6 w-auto" />
          </a>
          <p class="font-display text-base-content/80 text-h4 mt-4 max-w-xl font-normal">
            AI that does the compliance groundwork for India's CA firms.
          </p>
        </div>

        <div class="lg:col-span-5 lg:text-right">
          <a
            href="mailto:hello@nilahq.com"
            class="hover:text-base-content text-base-content/75 text-small inline-flex items-center gap-2 font-medium transition"
          >
            hello@nilahq.com <.icon name="hero-arrow-up-right" class="size-3.5" />
          </a>
        </div>
      </div>

      <div class="border-base-300/60 text-base-content/50 text-micro mt-10 flex flex-col gap-2 border-t pt-5 sm:flex-row sm:items-center sm:justify-between">
        <p>© 2026 Nila</p>
        <p>
          Operated by <span class="text-base-content/65">Kaguya Media Private Limited</span>
          · GSTIN <span class="text-base-content/65 tabular-nums">33AALCK1118R1Z8</span>
          · Chennai, India
        </p>
      </div>
    </div>
  </footer>
</div>
