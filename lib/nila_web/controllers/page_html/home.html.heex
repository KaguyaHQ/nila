<Layouts.flash_group flash={@flash} />

<div class="bg-base-100 text-base-content">
  <%!-- ── HEADER ─────────────────────────────────────────────────────────── --%>
  <header class="fixed inset-x-0 top-3 z-40 px-4 sm:top-4 sm:px-6">
    <div class="mx-auto flex w-fit items-center gap-8 rounded-full border border-base-300/60 bg-base-100/85 py-2 pl-5 pr-2 shadow-moon-lg backdrop-blur">
      <a href="/" class="flex items-center">
        <.logo class="h-6 w-auto text-base-content" />
      </a>
      <div class="flex items-center gap-1.5">
        <.link
          navigate={~p"/users/log_in"}
          class="hidden h-9 items-center px-3 text-small font-medium text-base-content/70 transition hover:text-base-content sm:inline-flex"
        >
          Log in
        </.link>
        <.link
          navigate={~p"/today"}
          class="inline-flex h-9 items-center gap-1.5 rounded-full bg-base-content px-4 text-small font-medium text-base-100 shadow-moon transition hover:opacity-90"
        >
          Open the app <.icon name="hero-arrow-right" class="size-3.5" />
        </.link>
      </div>
    </div>
  </header>

  <%!-- ── HERO ───────────────────────────────────────────────────────────── --%>
  <section class="moonlight-night relative overflow-hidden text-base-100">
    <div class="mx-auto flex max-w-3xl flex-col items-center px-4 pt-40 pb-28 text-center sm:px-6 sm:pt-48 sm:pb-36 lg:pt-56 lg:pb-44">
      <div class="moon-rise inline-flex items-center gap-2 rounded-full border border-base-100/15 bg-base-100/5 px-3 py-1 text-eyebrow font-semibold uppercase text-base-100/70 backdrop-blur">
        <span
          class="size-1.5 rounded-full bg-accent shadow-[0_0_10px_2px] shadow-accent/60"
          aria-hidden="true"
        ></span>
        For India's CA firms
      </div>

      <h1 class="moon-rise mt-8 font-display text-hero font-normal text-base-100 [animation-delay:80ms]">
        Serve more clients.
        <span class="italic text-accent whitespace-nowrap">Without adding staff.</span>
      </h1>

      <p class="moon-rise mt-8 max-w-xl text-lead font-light text-base-100/65 [animation-delay:160ms]">
        Nila does the groundwork your juniors do by hand. Bank statements
        classified, GSTR-2B reconciled, GST returns drafted, synced to Tally.
        Your team reviews and signs.
      </p>

      <div class="moon-rise mt-10 [animation-delay:240ms]">
        <.link
          navigate={~p"/today"}
          class="group inline-flex h-11 items-center gap-2 rounded-md bg-base-100 px-6 text-small font-medium text-base-content shadow-[0_0_30px_-4px] shadow-base-100/40 transition hover:shadow-[0_0_44px_-2px] hover:shadow-base-100/55"
        >
          Open the app
          <.icon
            name="hero-arrow-right"
            class="size-4 transition group-hover:translate-x-0.5"
          />
        </.link>
      </div>

      <%!-- Living proof, recessed into the night: a finished overnight run, the
           work already done, not a product screenshot. One quiet line, low
           contrast: a glance at what it produces, not a UI being presented. --%>
      <div class="moon-rise mt-20 w-full max-w-xl [animation-delay:340ms]">
        <p class="text-label font-medium uppercase text-base-100/35">
          Ready when you open it
        </p>
        <dl class="mt-5 divide-y divide-base-100/10 border-y border-base-100/10">
          <div class="flex items-baseline gap-4 py-3.5 text-left">
            <dt class="flex min-w-0 flex-1 items-center gap-2.5 text-small text-base-100/65">
              <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
              <span class="truncate">HDFC statement classified, 7 flagged for your review</span>
            </dt>
            <dd class="font-display text-body tabular-nums text-base-100/80">412 entries</dd>
          </div>
          <div class="flex items-baseline gap-4 py-3.5 text-left">
            <dt class="flex min-w-0 flex-1 items-center gap-2.5 text-small text-base-100/65">
              <span class="size-1.5 shrink-0 rounded-full bg-base-100/30" aria-hidden="true"></span>
              <span class="truncate">GSTR-2B reconciled against the books</span>
            </dt>
            <dd class="font-display text-body tabular-nums text-base-100/80">3 mismatches</dd>
          </div>
          <div class="flex items-baseline gap-4 py-3.5 text-left">
            <dt class="flex min-w-0 flex-1 items-center gap-2.5 text-small text-base-100/45">
              <span class="size-1.5 shrink-0 rounded-full bg-success/70" aria-hidden="true"></span>
              <span class="truncate line-through decoration-base-100/20">
                October GSTR-3B drafted, ready to file
              </span>
            </dt>
            <dd class="font-display text-body tabular-nums text-base-100/45">₹2,14,800</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <%!-- ── DOES THE WORK: the differentiator vs every tracker on the market ── --%>
  <section id="work" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
    <div class="max-w-2xl">
      <h2 class="font-display text-h2 font-normal">
        It doesn't track the work.
        <span class="italic text-base-content/50">It does the work.</span>
      </h2>
      <p class="mt-5 text-lead font-light text-base-content/65">
        Every other tool hands you a dashboard and leaves the typing to your
        juniors. Nila reads what arrives, classifies it, reconciles it against
        GSTR-2B, and hands back a finished draft. A person steps in only to
        review and sign.
      </p>
    </div>

    <div class="mt-14 grid items-stretch gap-4 lg:grid-cols-[1fr_auto_1fr] lg:gap-0">
      <%!-- raw input, muted --%>
      <div class="rounded-box border border-base-300/70 bg-base-200/40 p-5 sm:p-6">
        <p class="text-label font-semibold uppercase text-base-content/45">
          What arrives
        </p>
        <ul class="mt-3 divide-y divide-base-300/50">
          <%= for {icon, name, meta} <- [
            {"hero-document-text", "hdfc_statement.pdf", "Bank · 412 transactions"},
            {"hero-camera", "purchase bills", "WhatsApp · 14 photos"},
            {"hero-arrow-down-tray", "GSTR-2B · October", "GST portal · downloaded"}
          ] do %>
            <li class="flex items-center gap-3 py-3 first:pt-2">
              <.icon name={icon} class="size-4 shrink-0 text-base-content/40" />
              <div class="min-w-0">
                <p class="truncate text-small font-medium">{name}</p>
                <p class="truncate text-micro text-base-content/50">{meta}</p>
              </div>
            </li>
          <% end %>
        </ul>
      </div>

      <%!-- the engine, between the two --%>
      <div class="flex flex-col items-center justify-center gap-2 lg:px-7">
        <span class="grid size-10 place-items-center rounded-full bg-base-content text-base-100 shadow-moon">
          <.icon name="hero-sparkles" class="size-4" />
        </span>
        <.icon name="hero-arrow-down" class="size-4 text-base-content/40 lg:hidden" />
        <.icon name="hero-arrow-right" class="hidden size-4 text-base-content/40 lg:block" />
      </div>

      <%!-- finished draft, elevated: the payoff --%>
      <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-moon-lg sm:p-6">
        <p class="text-label font-semibold uppercase text-moon">
          What Nila produces
        </p>
        <div class="mt-4">
          <p class="text-small font-semibold tracking-tight tabular-nums">
            GSTR-3B · October 2026
          </p>
          <p class="mt-0.5 text-micro text-base-content/50">
            Anand Traders · monthly GST
          </p>
          <p class="mt-3 font-display text-h3 font-normal leading-none tabular-nums">
            ₹2,14,800<span class="text-base-content/40">.00</span>
          </p>
          <p class="mt-1 text-micro text-base-content/50">Net tax payable</p>
        </div>
        <dl class="mt-5 space-y-2.5 border-t border-base-300/40 pt-4">
          <%= for {label, value} <- [
            {"Input tax credit", "₹1,86,400"},
            {"Ledger", "Tally, synced"},
            {"Flagged", "7 for review"}
          ] do %>
            <div class="flex items-center justify-between gap-3 text-fine">
              <dt class="text-base-content/50">{label}</dt>
              <dd class="font-medium tabular-nums">{value}</dd>
            </div>
          <% end %>
        </dl>
        <p class="mt-4 flex items-center gap-1.5 text-micro font-medium text-success">
          <.icon name="hero-check-circle" class="size-3.5" /> Reconciled against GSTR-2B
        </p>
      </div>
    </div>
  </section>

  <%!-- ── LEARNS: the moat, night band, the thing a tracker can't copy ────── --%>
  <section class="moonlight-night relative overflow-hidden border-y border-base-100/5 text-base-100">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="text-eyebrow font-semibold uppercase text-base-100/40">
            Why it isn't just another tracker
          </p>
          <h2 class="mt-4 font-display text-h2 font-normal text-base-100">
            Every month, it knows your clients <span class="italic text-accent">better.</span>
          </h2>
          <p class="mt-6 text-lead font-light text-base-100/65">
            Trackers don't learn. A working engine does. Every statement, bill,
            and return teaches Nila how each client's books actually move, until
            the groundwork is finished before anyone opens it.
          </p>
        </div>

        <div class="lg:col-span-7">
          <dl class="grid gap-px overflow-hidden rounded-box border border-base-100/10 bg-base-100/10 sm:grid-cols-2">
            <%= for {month, label, body} <- [
              {"Month 1", "Learns the recurring entries", "Rent, salaries, regular vendors. It maps each client's repeat transactions to the right ledger head, the way your senior would."},
              {"Month 2", "Learns the exceptions", "The odd entries your juniors used to puzzle over get recognised and handled, not bounced back to a person."},
              {"Month 3", "Reconciliation sharpens", "Fewer GSTR-2B mismatches reach your desk. The ones that do are the ones that genuinely need judgement."},
              {"Month 6", "Review, don't produce", "Classification, reconciliation, and drafting are done before your team logs in. They review and sign."}
            ] do %>
              <div class="bg-[oklch(24%_0.05_245)] p-6">
                <p class="text-label font-semibold uppercase text-accent/80">
                  {month}
                </p>
                <p class="mt-2 font-display text-h4 text-base-100">{label}</p>
                <p class="mt-2 text-small font-light text-base-100/60">
                  {body}
                </p>
              </div>
            <% end %>
          </dl>
          <p class="mt-5 text-fine text-base-100/40">
            That accumulated context is the moat. It can't be cloned by bolting
            AI onto a form people fill in by hand.
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── COLLECTS: the chase clients never stop needing ─────────────────── --%>
  <section id="collects" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 class="font-display text-h2 font-normal">
          You stop chasing clients. <span class="italic text-base-content/50">Nila does it.</span>
        </h2>
        <p class="mt-6 text-lead font-light text-base-content/65">
          The two things that never stop: getting documents out of clients, and
          getting paid. Nila runs the follow-up over WhatsApp and email,
          composing, sending, reading the replies, and pulls you in only when a
          person is actually needed.
        </p>
        <p class="mt-7 text-fine text-base-content/55">
          The same chase, every month, off your plate.
        </p>
      </div>

      <div class="lg:col-span-7">
        <div class="overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-moon-lg">
          <div class="flex items-center justify-between border-b border-base-300/60 px-5 py-4 sm:px-6">
            <div class="min-w-0">
              <p class="truncate text-small font-semibold tracking-tight">
                Anand Traders · Q2 retainer
              </p>
              <p class="mt-0.5 text-fine text-base-content/55 tabular-nums">
                Reminder over WhatsApp and email
              </p>
            </div>
            <p class="text-small font-semibold tabular-nums">₹20,000.00</p>
          </div>

          <div class="flex items-center gap-4 px-5 py-7 sm:px-6">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-success/15 text-success">
              <.icon name="hero-check" class="size-6" />
            </span>
            <div class="min-w-0">
              <p class="text-h4 font-semibold tracking-tight">Paid</p>
              <p class="mt-0.5 text-fine text-base-content/55">
                after 2 reminders, none from you
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2 border-t border-base-300/60 bg-base-200/30 px-5 py-3 text-fine text-base-content/55 sm:px-6">
            <span class="flex items-center gap-1.5">
              Sent <span class="text-base-content/30">→</span>
              Reminder ×2 <span class="text-base-content/30">→</span>
              <span class="font-medium text-base-content/75">Paid</span>
            </span>
            <span class="ml-auto font-medium tabular-nums text-base-content/70">
              0 nudges from you
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── CLOSING CTA: close in night, bookend the hero ──────────────────── --%>
  <section class="moonlight-night relative overflow-hidden border-t border-base-100/5 text-base-100">
    <div class="mx-auto max-w-3xl px-4 py-28 text-center sm:px-6 sm:py-36">
      <h2 class="font-display text-statement font-normal text-base-100">
        Hand it the groundwork. <span class="block italic text-accent">Review and sign.</span>
      </h2>
      <p class="mx-auto mt-7 max-w-lg text-lead font-light text-base-100/60">
        Built for staffed CA firms running monthly GST, TDS, and bookkeeping
        across India.
      </p>
      <div class="mt-10 flex justify-center">
        <.link
          navigate={~p"/today"}
          class="group inline-flex h-12 items-center gap-2 rounded-md bg-base-100 px-6 text-body font-medium text-base-content shadow-[0_0_34px_-4px] shadow-base-100/40 transition hover:shadow-[0_0_48px_-2px] hover:shadow-base-100/55"
        >
          Open the app
          <.icon
            name="hero-arrow-right"
            class="size-4 transition group-hover:translate-x-0.5"
          />
        </.link>
      </div>
    </div>
  </section>

  <%!-- ── FOOTER ─────────────────────────────────────────────────────────── --%>
  <footer class="border-t border-base-300/60 bg-base-200/35">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-14">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <a href="/" class="inline-flex items-center">
            <.logo class="h-6 w-auto text-base-content" />
          </a>
          <p class="mt-4 max-w-xl font-display text-h4 font-normal text-base-content/80">
            AI that does the compliance groundwork for India's CA firms.
          </p>
        </div>

        <div class="lg:col-span-5 lg:text-right">
          <a
            href="mailto:hello@nilahq.com"
            class="inline-flex items-center gap-2 text-small font-medium text-base-content/75 transition hover:text-base-content"
          >
            hello@nilahq.com <.icon name="hero-arrow-up-right" class="size-3.5" />
          </a>
        </div>
      </div>

      <div class="mt-10 flex flex-col gap-2 border-t border-base-300/60 pt-5 text-micro text-base-content/50 sm:flex-row sm:items-center sm:justify-between">
        <p>© 2026 Nila</p>
        <p>
          Operated by <span class="text-base-content/65">Kaguya Media Private Limited</span>
          · GSTIN <span class="tabular-nums text-base-content/65">33AALCK1118R1Z8</span>
          · Chennai, India
        </p>
      </div>
    </div>
  </footer>
</div>
