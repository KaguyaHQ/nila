<.shell page_title="404 · Nila">
  <div class="space-y-block">
    <.numeral moon>
      <span>4</span><.crescent /><span>4</span>
    </.numeral>
    <h1 class="font-display text-base-content text-h3 font-normal">Not found in the books.</h1>
  </div>

  <div class="space-y-block">
    <.card class="space-y-block">
      <div class="flex items-start justify-between gap-4">
        <p class="text-ink-subtle text-label font-semibold uppercase">This page</p>
        <.badge variant="warning">Missing in 2B</.badge>
      </div>
      <dl class="divide-rule divide-y">
        <div class="flex items-baseline justify-between gap-4 py-3 first:pt-0 last:pb-0">
          <dt class="text-ink-subtle text-ui shrink-0">Requested by you</dt>
          <dd class="text-base-content text-ui min-w-0 text-right font-medium break-all">
            {requested_path(assigns)}
          </dd>
        </div>
        <div class="flex items-baseline justify-between gap-4 py-3 first:pt-0 last:pb-0">
          <dt class="text-ink-subtle text-ui shrink-0">Found in our register</dt>
          <dd class="text-ink-faint text-ui font-medium">—</dd>
        </div>
      </dl>
    </.card>

    <p class="text-body text-ink-muted">
      ITC on this page cannot be claimed. No matching document was found in the register.
    </p>
  </div>

  <%!-- One door. A 404 is a typo or a stale bookmark, so there is no second
        move to offer — mailing support about a URL is work nobody would do. --%>
  <div>
    <.button href={~p"/app/clients"}>Clients</.button>
  </div>
</.shell>
