<Layouts.app
  flash={@flash}
  page_title={@page_title}
  current_scope={@current_scope}
  current_path={assigns[:current_path]}
>
  <div id="assistant-page" class="mx-auto flex h-[calc(100vh-8rem)] max-w-4xl flex-col gap-4">
    <div
      :if={@turns == []}
      class="flex flex-1 -translate-y-20 flex-col items-center justify-center gap-6"
    >
      <div class="flex flex-col items-center gap-2 text-center">
        <p class="text-eyebrow text-moon font-semibold uppercase">Assistant</p>
        <h1 class="font-display text-base-content text-h2 font-normal">
          Ask about your documents
        </h1>
        <p class="text-base-content/70 text-small max-w-md font-light">
          Read-only. The assistant looks up your ingested documents and shows them as cards.
        </p>
      </div>

      <div class="w-full max-w-2xl">
        <.composer draft={@draft} pending?={@pending?} />
      </div>
      <.example_chips />
    </div>

    <div :if={@turns != []} class="flex flex-1 flex-col gap-4 overflow-hidden">
      <div id="assistant-thread" class="flex-1 space-y-6 overflow-y-auto py-2">
        <div :for={turn <- @turns} id={"turn-#{turn.id}"} class="space-y-2">
          <div :if={turn.role == :user} class="flex justify-end">
            <div class="bg-primary rounded-box text-body text-primary-content w-fit max-w-[80%] px-3 py-1.5">
              <.preserve_newlines text={turn.text} />
            </div>
          </div>

          <div :if={turn.role == :assistant} class="space-y-3">
            <div :if={turn.text != ""} class="text-base-content text-body max-w-2xl">
              <.preserve_newlines text={turn.text} />
              <span
                :if={(turn[:citations] || []) != []}
                class="ml-2 inline-flex flex-wrap gap-1 align-baseline"
              >
                <.link
                  :for={citation <- turn[:citations] || []}
                  navigate={citation.url}
                  title={citation.label}
                  class="bg-base-200 border-base-300 hover:bg-base-300 hover:border-base-content/20 rounded-field text-base-content/70 text-micro inline-flex h-5 items-center border px-1.5 font-medium transition"
                >
                  [{citation.index}]
                </.link>
              </span>
            </div>

            <div :for={{tag, items} <- turn[:attachments] || []} class="space-y-2">
              <div :if={tag == :documents} class="grid gap-2 sm:grid-cols-2">
                <.document_card :for={doc <- items} doc={doc} />
              </div>
            </div>
          </div>
        </div>

        <div :if={@trace_steps != []} id="assistant-trace" class="max-w-2xl space-y-1">
          <details
            :for={step <- @trace_steps}
            id={"trace-step-#{step.id}"}
            open={step.status == :running}
            class="bg-base-100/80 border-base-300 group rounded-field shadow-moon text-small border"
          >
            <summary class="hover:bg-base-200 text-base-content/70 flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2 transition">
              <span class="flex min-w-0 items-center gap-2">
                <span class={[
                  "inline-flex size-5 shrink-0 items-center justify-center rounded-full",
                  step.status == :running && "bg-info/10 text-info",
                  step.status == :done && "bg-success/10 text-success",
                  step.status == :error && "bg-error/10 text-error"
                ]}>
                  <.icon
                    :if={step.status == :running}
                    name="hero-arrow-path"
                    class="size-3 animate-spin"
                  />
                  <.icon :if={step.status == :done} name="hero-check" class="size-3" />
                  <.icon :if={step.status == :error} name="hero-x-mark" class="size-3" />
                </span>
                <span class="truncate font-medium">{step.title}</span>
              </span>
              <span class="text-base-content/50 text-micro shrink-0 tabular-nums">
                {trace_elapsed(step.elapsed_ms)}
              </span>
            </summary>
            <div class="border-base-200 text-base-content/60 text-fine border-t px-10 py-2">
              {step.detail}
            </div>
          </details>
        </div>

        <div
          :if={@streaming_text != ""}
          id="assistant-streaming-turn"
          class="text-base-content text-body max-w-2xl"
        >
          <.preserve_newlines text={@streaming_text} />
        </div>
      </div>

      <.composer draft={@draft} pending?={@pending?} />
    </div>
  </div>
</Layouts.app>
